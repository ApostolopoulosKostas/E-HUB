<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/brown">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="E-HUB"
        android:textColor="@color/orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textSize="40sp"
        android:layout_marginTop="40sp"/>


    <EditText
        android:id="@+id/employeeNameInput"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:hint="Όνομα εργαζομένου"
        android:background="@color/white"
        android:textColor="@color/black"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp" />



    <EditText
        android:id="@+id/emailInput"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:hint="Email"
        android:background="@color/white"
        android:textColor="@color/black"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/employeeNameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp" />


    <EditText
        android:id="@+id/registrationCodeInput"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:hint="Κωδικός εγγραφής"
        android:background="@color/white"
        android:textColor="@color/black"
        android:inputType="textPassword"
        app:layout_constraintTop_toBottomOf="@+id/emailInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        />


    <Button
        android:id="@+id/registerButton"
        android:layout_width="280dp"
        android:layout_height="55dp"
        android:text="ΕΓΓΡΑΦΗ"
        android:textSize="18sp"
        android:backgroundTint="@color/orange"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/registrationCodeInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp" />

</androidx.constraintlayout.widget.ConstraintLayout>